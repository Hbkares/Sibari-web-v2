# Canonical production origin — required for correct metadataBase, OG/Twitter
# absolute URLs, sitemap.xml, and robots.txt before launch (SIB-13). Falls
# back to a placeholder in dev so the build doesn't fail without it.
NEXT_PUBLIC_SITE_URL=https://sibari.example

# Spotify Web API (Client Credentials flow — catalog reads only, no user
# auth). Create an app at https://developer.spotify.com/dashboard to get
# these. The Music section (SIB-26) renders an empty state without them.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Defaults to Sibari's artist ID if unset — override only for a different artist/environment.
SPOTIFY_ARTIST_ID=5BSUZoXPBUMHc0URd1L1xQ

# YouTube Data API v3 (public API key — no OAuth, read-only playlistItems/
# videos calls). Create one at https://console.cloud.google.com/apis/credentials.
# The Remakes section (SIB-27/33) renders an empty state without it.
YOUTUBE_API_KEY=
# Defaults to the "FL Studio Remakes" playlist on youtube.com/@Hbkares — override only if the client asks for a different curated list (SIB-27 §1/§6).
YOUTUBE_REMAKES_PLAYLIST_ID=PLfofkk7lDOSta6WROCGuuXmrA-59uIU73
