# Sanity project isn't provisioned yet — see SIB-4/SIB-8. Rooms render with
# empty-state copy until these are set; nothing breaks without them.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01

# Canonical production origin — required for correct metadataBase, OG/Twitter
# absolute URLs, sitemap.xml, and robots.txt before launch (SIB-13). Falls
# back to a placeholder in dev so the build doesn't fail without it.
NEXT_PUBLIC_SITE_URL=https://sibari.example
